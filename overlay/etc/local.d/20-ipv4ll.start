#!/bin/sh
# Start the IPv4LL (RFC 3927) address manager for the link-test interface.
#
# It's launched in the background because it must keep running to hold and
# re-claim the 169.254.x.x address across cable unplug/replug -- a plain
# run-once-at-boot script can't do that, and local.d would block boot waiting
# for it to exit. Real logic lives in /usr/local/bin/linktest-ipv4ll.
set -e

IFACE="${LINKTEST_IFACE:-eth0}"
PIDFILE=/run/linktest/ipv4ll.pid

mkdir -p /run/linktest

# Idempotent: do nothing if it's already up. Checked directly with kill -0
# rather than `start-stop-daemon --status`: OpenRC's start-stop-daemon (the
# one actually on this image -- confirmed by booting in QEMU) doesn't
# support --status as a standalone query the way Debian's does; it printed
# its own usage/help and returned non-zero unconditionally, meaning this
# would never detect an already-running daemon and would launch a second
# copy on every re-run.
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
	exit 0
fi

start-stop-daemon --start --background \
	--make-pidfile --pidfile "$PIDFILE" \
	--exec /usr/local/bin/linktest-ipv4ll -- "$IFACE"
